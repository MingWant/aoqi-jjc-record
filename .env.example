HOST=127.0.0.1
PORT=8787
DATA_FILE=./data/arena-tracker.sqlite

# account: use a Duoduo account id directly; username: resolve it first.
ARENA_LOGIN_MODE=account
ARENA_ACCOUNT=
ARENA_USERNAME=
ARENA_PASSWORD=
ARENA_ZONE_PREFERENCE=
ARENA_LOGIN_BASE_URL=http://login2-aoqi.100bt.com
ARENA_LOGIN_PATH=/newLogin

ARENA_POLL_INTERVAL_SECONDS=300
ARENA_FINAL_POLL_INTERVAL_SECONDS=30
ARENA_FINAL_CAPTURE_WINDOW_MINUTES=15
ARENA_SETTLEMENT_GRACE_MINUTES=3
ARENA_REQUEST_TIMEOUT_MS=12000
ARENA_COLLECTION_RETRIES=1
ARENA_UTC_OFFSET_MINUTES=480
ARENA_TIMEZONE=Asia/Shanghai

ARENA_SEASON_ID=32
ARENA_SEASON_LABEL=第32届
ARENA_SEASON_START=2026-07-03T12:00:00+08:00
ARENA_SEASON_END=
# Optional: set a fixed number of settlement weeks; end date is calculated automatically.
ARENA_SEASON_WEEKS=
ARENA_HALL_SEASON_WINDOW=3

# Required to enter the dashboard and read ranking data.
ACCESS_TOKEN=
# Required for manual write operations (player profiles, labels, backfill).
ADMIN_TOKEN=
LOG_LEVEL=info
